# Supabase project credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-publishable-key

# LLM provider credentials
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key

# Exact browser origins, comma-separated (no wildcard)
CORS_ORIGINS=http://localhost:3000,https://your-production-frontend.example.com

# Supabase Auth UUIDs allowed to create/process job postings.
# Empty means admin-only endpoints fail closed.
JOB_ADMIN_USER_IDS=
